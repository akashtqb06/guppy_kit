{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@guppy-kit/config/typescript/nextjs",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@guppy-kit/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@guppy-kit/ui/*": [
        "../../packages/ui/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}