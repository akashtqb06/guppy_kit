{
  "name": "@guppy-kit/types",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types for Guppy Kit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@guppy-kit/config": "workspace:*",
    "typescript": "^7.0.2"
  },
  "files": ["dist"]
}
